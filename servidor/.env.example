# Copia este archivo como ".env" (no se sube a GitHub) y rellénalo.
# En Render, estas mismas variables se ponen en Environment del servicio.

# --- MySQL: elige UNA de las dos formas ---
# a) URL completa (la que da Aiven en "Service URI"):
# DATABASE_URL=mysql://avnadmin:CONTRASEÑA@servidor.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# b) Datos por separado. Con XAMPP: usuario root y contraseña vacía.
#    La base "umbrella" la crea esquema.sql (utf8mb4 / utf8mb4_general_ci).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=umbrella

# Conexión cifrada (obligatoria en Aiven). Pega el certificado "CA" del proveedor
# en MYSQL_CA (en Render) o indica dónde lo guardaste en MYSQL_CA_FILE (en local).
# MYSQL_SSL=true
# MYSQL_CA_FILE=./ca.pem

# Frase larga y aleatoria para firmar la cookie de sesión.
SESSION_SECRET=cambia-esto-por-una-frase-larga-y-aleatoria

# Client ID de Google (Google Cloud Console > APIs y servicios > Credenciales).
# Si lo dejas vacío, el botón de Google se oculta y solo funciona el email.
GOOGLE_CLIENT_ID=
